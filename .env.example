# =============================================================================
# Legend Trade — environment configuration
#
# Copy to .env and fill in what you need. `.env` is gitignored; never commit
# real keys. Everything here is optional: the trading terminal runs with no
# credentials at all, using the keyless market data providers.
# =============================================================================

# --- Narrative prose (optional) ----------------------------------------------
# The ONLY place this platform calls a language model. It turns a completed
# analysis into a prose walkthrough; without a key every analysis section is
# still computed identically and the deterministic summary is returned instead,
# and research mode falls back to the built-in concept glossary.
#
# No signal, probability or risk decision anywhere in this codebase consults a
# model. They are arithmetic on price data and reproducible from the same input.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Market data -------------------------------------------------------------
# Leave MARKET_DATA_PROVIDER as "auto" and the platform picks per symbol:
#   crypto  -> binance, falling back to coinbase where Binance is geo-blocked
#   stocks, ETFs, indices, FX, futures -> the first configured keyed provider,
#                                         falling back to keyless Yahoo Finance
#
# No key is required for: binance, coinbase, yahoo.
# Yahoo covers the entire listed universe including small and micro caps
# (NASDAQ:SERV, IONQ, LUNR), indices (^RUT), futures (ES=F) and FX (EURUSD).
# It is an undocumented endpoint and rate-limits per IP, so for production
# equity use configure one of the keyed providers below — the platform prefers
# a keyed provider automatically and falls back to Yahoo only if it fails.
MARKET_DATA_PROVIDER=auto

# Polygon.io — stocks, options, indices, FX, crypto. The best equity source
# here, and the only one that serves individual option contracts.
POLYGON_API_KEY=

# Twelve Data — stocks, FX, indices, ETFs, commodities. Generous free tier.
TWELVEDATA_API_KEY=

# Finnhub — stocks, FX, crypto. Useful as a second equity source.
FINNHUB_API_KEY=

# Alpha Vantage — stocks, ETFs, FX, crypto. Free key, but a small quota
# (5 requests/minute, 25/day), so it sits low in the preference order.
ALPHAVANTAGE_API_KEY=

# FRED (St. Louis Fed) — powers the economic calendar (/calendar). Free,
# instant registration at https://fred.stlouisfed.org/docs/api/api_key.html.
# Without it, news risk in the risk engine stays honestly "unmodelled".
FRED_API_KEY=

# --- Authentication ----------------------------------------------------------
# always | never | auto (default). "auto" enforces authentication unless the
# server is bound to loopback, so a localhost run stays frictionless while
# anything listening on a real interface is protected by default.
#
# Every LEGEND_* name below also answers to its old DEX_* spelling, so an .env
# carried over from Project-DEX keeps working. The one exception is
# LEGEND_ENABLE_LIVE_TRADING at the bottom of this file.
LEGEND_AUTH_REQUIRED=auto

# Token signing secret. Leave empty and one is generated and saved to
# ~/.legend-trade/secret_key so restarts don't sign everyone out. Set it explicitly for
# any deployment running more than one instance, or tokens issued by one will
# be rejected by the others.
LEGEND_SECRET_KEY=

# Whether accounts beyond the first can be created. The first account is always
# allowed, so a fresh install can be set up. Leave false for a private instance.
LEGEND_ALLOW_SIGNUP=false

# Set true ONLY when running behind a reverse proxy you control. It makes the
# rate limiter trust X-Forwarded-For; trusting it while directly exposed would
# let any client spoof a fresh identity per request and bypass the limit.
LEGEND_TRUST_PROXY_HEADERS=false

# --- Observability ------------------------------------------------------------
# "text" (default) is human-readable; "json" emits one parseable object per
# line — including uvicorn's own access lines — for a log shipper.
LOG_FORMAT=text
LOG_LEVEL=INFO

# GET /metrics serves Prometheus exposition format. It is admin-only whenever
# authentication is enforced, because metrics leak operational shape (which
# endpoints exist, how much traffic each takes). Point a scraper at it with an
# admin bearer token, or set this false to remove it.
METRICS_ENABLED=true

# --- Rate limiting ------------------------------------------------------------
# Left empty, rate-limit buckets live in each worker's memory — correct for a
# single-instance deployment, but behind N workers the effective limit becomes
# N times what you configured. Set this to share one bucket across every
# worker. A Redis outage falls back to in-process buckets rather than failing
# open or closed, so this is safe to point at a Redis that might blink.
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Password reset email (optional) ------------------------------------------
# Leave SMTP_HOST empty and a requested reset link is logged instead of
# emailed — genuinely usable on a self-hosted instance where you have log
# access, not just a stub. Set these to actually send the email (a Gmail app
# password works fine for SMTP_USERNAME/SMTP_PASSWORD).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=legend@localhost
SMTP_USE_TLS=true

# Where the frontend is served, so a reset email can link back to it.
FRONTEND_URL=http://localhost:5173

# --- Broker execution --------------------------------------------------------
# Broker credentials are read from this environment ONLY — never from the
# database. Storing per-user broker keys would need real encryption at rest,
# and that is not something to improvise. The consequence is that connecting a
# broker is an instance-level capability, not a per-user one.
#
# Leave everything below empty and the platform runs in internal paper mode,
# which is the default and needs no broker at all.

# Alpaca paper trading. Get a key pair at https://app.alpaca.markets (Paper).
# Used by both the "Paper" and "Broker paper" modes — no real money either way.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Alpaca LIVE trading — real money. Separate variable names from the paper pair
# on purpose: a copy-paste slip between two identically-named keys must not be
# able to point live credentials at what you believe is a paper account.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# Tradier — the second broker adapter. Sandbox token from
# https://developer.tradier.com (Sandbox), plus the account number it applies
# to. NOTE: unlike Alpaca, this adapter has not been exercised against a real
# Tradier account from this repo — verify a few round trips in sandbox mode
# (POST /execution/broker {"broker":"tradier"}, then broker_paper mode) before
# ever pointing TRADIER_LIVE_* at it. Long-only; see trading/execution/tradier.py.
TRADIER_PAPER_TOKEN=
TRADIER_PAPER_ACCOUNT_ID=
TRADIER_LIVE_TOKEN=
TRADIER_LIVE_ACCOUNT_ID=

# Interactive Brokers — the third broker adapter, and a different shape from
# the other two: there is no key/secret pair. IBKR requires a separately
# running "Client Portal Gateway" process that you download from IBKR and
# authenticate by logging into in a browser (defaults to localhost:5000) —
# these variables only tell the adapter which account to address once that
# session exists, they do not create it. Unverified against a real account
# and reconstructed from web search rather than IBKR's own docs (which 403'd
# during development) — read trading/execution/ibkr.py's module docstring
# before ever pointing IBKR_LIVE_ACCOUNT_ID at real money.
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_VERIFY_SSL=false
IBKR_PAPER_ACCOUNT_ID=
IBKR_LIVE_ACCOUNT_ID=

# The instance-level switch for live trading. Without it, live mode is
# unreachable no matter what any API request, database row or UI click says.
# It is server-side and requires a restart deliberately — so turning on real
# money is an act of deployment, not an act of clicking.
#
# Even with this true, an order still needs: mode set to live, the phrase
# "TRADE LIVE MONEY" typed to arm a 30-minute window, a protective stop on the
# order, and — if it comes from a strategy — an APPROVED audit plus at least
# 20 closed paper trades.
#
# Unlike every other setting here, this one does NOT answer to its old
# DEX_ENABLE_LIVE_TRADING spelling. A leftover variable from a differently-named
# product must not arm real money without someone deciding to — see the comment
# in trading/execution/guardrails.py.
LEGEND_ENABLE_LIVE_TRADING=false

# --- Server ------------------------------------------------------------------
# Binding to 0.0.0.0 makes the server reachable off-host, which switches
# authentication on under the default "auto" mode.
HOST=127.0.0.1
PORT=8000
